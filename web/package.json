{
  "name": "gridkit-react",
  "version": "0.1.0",
  "description": "Development-time layout grid overlays for React web apps — columns, baseline rhythm, modules, key lines and a floating control panel, toggled on top of your running site.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acrosa/GridKit.git",
    "directory": "web"
  },
  "homepage": "https://github.com/acrosa/GridKit/tree/main/web#readme",
  "keywords": [
    "react",
    "grid",
    "overlay",
    "baseline",
    "layout",
    "design",
    "devtools",
    "typography"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
